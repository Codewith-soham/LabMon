# Frontend environment (Vite). Copy to `.env` for local dev; never commit `.env`.
# Only vars prefixed with VITE_ are exposed to the client bundle.

# Base URL of the LABMON backend API, including the /api/v1 prefix.
# Falls back to http://localhost:8000/api/v1 when unset (see src/services/apiClient.ts).
VITE_API_BASE_URL=http://localhost:8000/api/v1
