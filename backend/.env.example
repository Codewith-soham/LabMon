# --- Core ---
PORT=8000
MONGO_URL=
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- JWT (see src/utils/tokenGeneration.ts) ---
JWT_ACCESS_TOKEN=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_TOKEN=
JWT_REFRESH_EXPIRY=7d

# --- Mail (optional; when SMTP_HOST is unset the OTP email is logged instead) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=LABMON <no-reply@labmon.local>

# --- OTP tuning (optional) ---
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# --- Rate limiting (optional; disabled entirely when NODE_ENV=test) ---
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_OTP_VERIFY_MAX=10
RATE_LIMIT_OTP_RESEND_WINDOW_MS=900000
RATE_LIMIT_OTP_RESEND_MAX=5
RATE_LIMIT_COMPLAINT_WINDOW_MS=3600000
RATE_LIMIT_COMPLAINT_MAX=20
RATE_LIMIT_PC_SYNC_WINDOW_MS=60000
RATE_LIMIT_PC_SYNC_MAX=30
